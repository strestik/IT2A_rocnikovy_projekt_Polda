<Window x:Class="IT2A_rocnikovy_projekt_Polda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IT2A_rocnikovy_projekt_Polda"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        Title="MainWindow" Height="1080" Width="1920">
    <Grid>
        <Image Name="MapImage"
       Source="/img/room.png"
       Stretch="Fill"
       MouseDown="MapImage_MouseDown"/>

        <Canvas Name="OverlayCanvas"/>
        <Button Content="" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="120" Margin="10,10,0,0" Click="MenuButton_Click" FontSize="24" BorderBrush="{x:Null}" Foreground="{x:Null}" Cursor="None" IsDefault="True" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <Button.Background>
                <ImageBrush ImageSource="/img/menuButton.png" TileMode="None"/>
            </Button.Background>
        </Button>
        
        <Rectangle x:Name="DisplayBlock" Margin="360,10,490,885" Fill="#D8DAA454" StrokeThickness="10" Panel.ZIndex="3" Visibility="Collapsed">
            <Rectangle.Stroke>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF6F3B10" Offset="0.429"/>
                    <GradientStop Color="#F2A05719" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Stroke>
        </Rectangle>
        <TextBlock x:Name="DisplayText" HorizontalAlignment="Left" Margin="380,30,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="145" Width="1030" Panel.ZIndex="4" FontSize="46" UseLayoutRounding="True" FontFamily="Palatino Linotype" ScrollViewer.VerticalScrollBarVisibility="Disabled" Visibility="Collapsed"/>

    </Grid>
</Window>